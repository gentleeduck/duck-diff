{
  "name": "@duck-diff/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": { "duck-diff": "./src/cli.ts" },
  "scripts": {
    "build": "bun ../../scripts/gen-web-assets.ts && bun ../../scripts/build-binary.ts",
    "check-types": "bun ../../scripts/gen-web-assets.ts && tsc -p tsconfig.json --noEmit",
    "dev": "bun ../../scripts/gen-web-assets.ts && bun --watch src/cli.ts serve --repo ../..",
    "test": "bun ../../scripts/gen-web-assets.ts && bun test",
    "test:coverage": "bun ../../scripts/gen-web-assets.ts && bun test --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": { "@duck-diff/git": "workspace:*", "@duck-diff/protocol": "workspace:*", "zod": "catalog:" },
  "devDependencies": {
    "@duck-diff/testing": "workspace:*",
    "@duck-diff/typescript-config": "workspace:*",
    "@duck-diff/web": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.2",
    "typescript": "catalog:"
  }
}
