{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@gentleduck/diff",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "workspaces": {
    "packages": ["apps/*", "packages/*", "tooling/*"],
    "catalog": {
      "@biomejs/biome": "2.5.13",
      "@pierre/diffs": "1.5.2",
      "@tanstack/react-virtual": "^3.13.12",
      "diff": "^8.0.2",
      "@tailwindcss/vite": "^4.3.3",
      "@testing-library/react": "^16.3.3",
      "@types/node": "^26.5.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.2",
      "@vitest/coverage-v8": "^5.0.0",
      "jsdom": "^30.1.2",
      "react": "^19.3.0",
      "shiki": "4.5.0",
      "react-dom": "^19.3.0",
      "tailwindcss": "^4.3.3",
      "typescript": "7.0.2",
      "vite": "^8.3.4",
      "vitest": "^5.0.0",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "build": "turbo run build --concurrency=4",
    "check": "biome check .",
    "check-types": "turbo run check-types --concurrency=4",
    "ci": "bun run check && bun run check-types && bun run build && bun run test:coverage",
    "clean": "turbo run clean && rm -rf .turbo",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "husky",
    "test": "turbo run test --concurrency=4",
    "test:coverage": "turbo run test:coverage --concurrency=4",
    "verify": "bun run ci && bun run test:e2e",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "test:nvim": "nvim --headless -l tests/nvim/run.lua",
    "bench": "bun run --cwd apps/server bench"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@duck-diff/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  }
}
